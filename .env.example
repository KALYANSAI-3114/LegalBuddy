# Environment Configuration Example
# Copy this file to backend/.env and update values as needed

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Ollama Configuration (IMPORTANT: These must match your Ollama setup)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
# Alternative models: llama3:latest, tinyllama:latest, neural-chat:latest

# Note: These folders are auto-created if they don't exist
# DATA_FOLDER=data              # Auto-resolved to project root/data
# CHROMA_DB_PATH=./chroma_db    # Auto-resolved relative path

